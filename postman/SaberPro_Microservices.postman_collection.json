              "raw": "{{question_service_url}}/questions/{{questionId}}/submit",
              "host": ["{{question_service_url}}"],
              "path": ["questions", "{{questionId}}", "submit"]
            }
          }
        },
        {
          "name": "Consultar operación (COMPLETED, con reintento)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const opId = pm.collectionVariables.get('operationId');",
                  "let tries = 0;",
                  "function check() {",
                  "  pm.sendRequest({",
                  "    url: pm.collectionVariables.get('question_service_url') + '/operations/' + opId,",
                  "    method: 'GET'",
                  "  }, (err, res) => {",
                  "    if (err || !res) { return; }",
                  "    let body = {};",
                  "    try { body = res.json(); } catch (e) { return; }",
                  "    if (body.status === 'PENDING' && tries < 10) {",
                  "      tries++;",
                  "      setTimeout(check, 1000);",
                  "      return;",
                  "    }",
                  "    pm.test('operación COMPLETED', () => pm.expect(body.status).to.eql('COMPLETED'));",
                  "    pm.test('tipo SUBMIT_FOR_REVIEW', () => pm.expect(body.type).to.eql('SUBMIT_FOR_REVIEW'));",
                  "  });",
                  "}",
                  "check();"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{question_service_url}}/operations/{{operationId}}",
              "host": ["{{question_service_url}}"],
              "path": ["operations", "{{operationId}}"]
            }
