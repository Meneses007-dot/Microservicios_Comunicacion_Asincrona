        {
          "name": "Verificar operación fallida (FAILED, con reintento)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const opId = pm.collectionVariables.get('operationId2');",
                  "let tries = 0;",
                  "function check() {",
                  "  pm.sendRequest({",
                  "    url: pm.collectionVariables.get('question_service_url') + '/operations/' + opId,",
                  "    method: 'GET'",
                  "  }, (err, res) => {",
                  "    if (err || !res) { return; }",
                  "    let body = {};",
                  "    try { body = res.json(); } catch (e) { return; }",
                  "    if (body.status === 'PENDING' && tries < 10) {",
                  "      tries++;",
                  "      setTimeout(check, 1000);",
                  "      return;",
                  "    }",
                  "    pm.test('operación FAILED (nunca COMPLETED)', () => pm.expect(body.status).to.eql('FAILED'));",
                  "    pm.test('incluye el motivo', () => pm.expect(body.message).to.include('Transición no permitida'));",
                  "  });",
                  "}",
                  "check();"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{question_service_url}}/operations/{{operationId2}}",
              "host": ["{{question_service_url}}"],
              "path": ["operations", "{{operationId2}}"]
