                  "  pm.sendRequest({",
                  "    url: pm.collectionVariables.get('notification_service_url') + '/notifications',",
                  "    method: 'GET'",
                  "  }, (err, res) => {",
                  "    if (err || !res) { return; }",
                  "    let body = [];",
