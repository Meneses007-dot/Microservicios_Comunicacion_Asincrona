    {
      "name": "7. Flujo E2E (ejecutar en orden)",
      "description": "Recorre el Escenario 1 completo: login, creación, validación, envío asíncrono, asignación, aprobación y verificación de estados. Requiere RabbitMQ y los 6 servicios arriba.",
      "item": [
        {
          "name": "E2E 1 - Login docente",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('200', () => pm.response.to.have.status(200));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"teacher\",\n  \"password\": \"secret123\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{user_service_url}}/auth/login", "host": ["{{user_service_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "E2E 2 - Crear pregunta",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 DRAFT', () => { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('e2eQuestionId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"E2E\",\n  \"text\": \"¿Cuál es la capital de Colombia?\",\n  \"options\": [\n    { \"id\": \"a\", \"text\": \"Bogotá\" },\n    { \"id\": \"b\", \"text\": \"Medellín\" },\n    { \"id\": \"c\", \"text\": \"Cali\" },\n    { \"id\": \"d\", \"text\": \"Popayán\" }\n  ],\n  \"correctOptionId\": \"a\",\n  \"authorId\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{question_service_url}}/questions", "host": ["{{question_service_url}}"], "path": ["questions"] }
          }
        },
        {
          "name": "E2E 3 - Enviar a revisión",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202', () => pm.response.to.have.status(202));",
                  "pm.collectionVariables.set('e2eOperationId', pm.response.json().operationId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "" },
            "url": { "raw": "{{question_service_url}}/questions/{{e2eQuestionId}}/submit", "host": ["{{question_service_url}}"], "path": ["questions", "{{e2eQuestionId}}", "submit"] }
          }
        },
        {
          "name": "E2E 4 - Verificar COMPLETED y PENDING_REVIEW",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const opId = pm.collectionVariables.get('e2eOperationId');",
                  "const qid = pm.collectionVariables.get('e2eQuestionId');",
                  "let tries = 0;",
                  "function check() {",
                  "  pm.sendRequest({ url: pm.collectionVariables.get('question_service_url') + '/operations/' + opId, method: 'GET' }, (err, res) => {",
                  "    if (err || !res) { return; }",
                  "    let body = {};",
                  "    try { body = res.json(); } catch (e) { return; }",
                  "    if (body.status === 'PENDING' && tries < 10) { tries++; setTimeout(check, 1000); return; }",
                  "    pm.test('operación COMPLETED', () => pm.expect(body.status).to.eql('COMPLETED'));",
                  "    pm.sendRequest({ url: pm.collectionVariables.get('lifecycle_service_url') + '/lifecycle/' + qid, method: 'GET' }, (e2, r2) => {",
                  "      if (e2 || !r2) { return; }",
                  "      pm.test('estado PENDING_REVIEW', () => pm.expect(r2.json().state).to.eql('PENDING_REVIEW'));",
                  "    });",
                  "  });",
                  "}",
                  "check();"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": { "raw": "{{question_service_url}}/operations/{{e2eOperationId}}", "host": ["{{question_service_url}}"], "path": ["operations", "{{e2eOperationId}}"] } }
        },
        {
          "name": "E2E 5 - Asignar revisor",
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": ["pm.test('201 ASSIGNED', () => pm.response.to.have.status(201));"] }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"questionId\": {{e2eQuestionId}},\n  \"reviewerId\": 4,\n  \"assignedBy\": \"admin\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{review_service_url}}/reviews/assign", "host": ["{{review_service_url}}"], "path": ["reviews", "assign"] }
          }
        },
        {
          "name": "E2E 6 - Verificar notificación asíncrona",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const qid = pm.collectionVariables.get('e2eQuestionId');",
                  "let tries = 0;",
                  "function check() {",
                  "  pm.sendRequest({ url: pm.collectionVariables.get('notification_service_url') + '/notifications', method: 'GET' }, (err, res) => {",
                  "    if (err || !res) { return; }",
                  "    let body = [];",
                  "    try { body = res.json(); } catch (e) { return; }",
                  "    const found = (body || []).some(n => String(n.questionId) === String(qid));",
                  "    if (!found && tries < 10) { tries++; setTimeout(check, 1000); return; }",
                  "    pm.test('notificación generada', () => pm.expect(found).to.be.true);",
                  "  });",
                  "}",
                  "check();"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": { "raw": "{{notification_service_url}}/notifications", "host": ["{{notification_service_url}}"], "path": ["notifications"] } }
        },
        {
          "name": "E2E 7 - Aprobar revisión",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 APPLIED', () => { pm.response.to.have.status(200); });",
                  "pm.test('result APPROVED', () => pm.expect(pm.response.json().result).to.eql('APPROVED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"reviewerId\": 4,\n  \"result\": \"APPROVED\",\n  \"comments\": \"Cumple con los criterios\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{review_service_url}}/reviews/{{e2eQuestionId}}/result", "host": ["{{review_service_url}}"], "path": ["reviews", "{{e2eQuestionId}}", "result"] }
          }
        },
        {
          "name": "E2E 8 - Verificar estado APPROVED",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('estado APPROVED', () => pm.expect(pm.response.json().state).to.eql('APPROVED'));"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": { "raw": "{{lifecycle_service_url}}/lifecycle/{{e2eQuestionId}}", "host": ["{{lifecycle_service_url}}"], "path": ["lifecycle", "{{e2eQuestionId}}"] } }
        },
        {
          "name": "E2E 9 - Reenviar aprobada (202 -> FAILED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 aceptado', () => pm.response.to.have.status(202));",
                  "const opId = pm.response.json().operationId;",
                  "let tries = 0;",
                  "function check() {",
                  "  pm.sendRequest({ url: pm.collectionVariables.get('question_service_url') + '/operations/' + opId, method: 'GET' }, (err, res) => {",
                  "    if (err || !res) { return; }",
                  "    let body = {};",
                  "    try { body = res.json(); } catch (e) { return; }",
                  "    if (body.status === 'PENDING' && tries < 10) { tries++; setTimeout(check, 1000); return; }",
                  "    pm.test('FAILED (APPROVED -> PENDING_REVIEW no permitida)', () => pm.expect(body.status).to.eql('FAILED'));",
                  "  });",
                  "}",
                  "check();"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "" },
            "url": { "raw": "{{question_service_url}}/questions/{{e2eQuestionId}}/submit", "host": ["{{question_service_url}}"], "path": ["questions", "{{e2eQuestionId}}", "submit"] }
          }
        }
      ]
    }
  ]
